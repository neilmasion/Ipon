# ==========================================
# Ipon Application Environment Variables
# ==========================================

# Application Runtime Environment
# Note for Railway / Hosting: Set NODE_ENV to production (or leave empty, Next.js sets it automatically)
NODE_ENV="production"
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME"

# JWT Secret - generate with: openssl rand -base64 32
JWT_SECRET="replace-with-a-secure-random-32-byte-secret-key-in-production"

# Rate Limiting Settings
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=120

# Cookie Security (set to true in production with HTTPS)
SECURE_COOKIES=false

# ==========================================
# 100% FREE Gmail SMTP Email Authentication
# ==========================================
# Free sending for 6-digit verification codes & password resets (up to 500 emails/day)
# Steps:
# 1. Enable 2-Step Verification in Google Account (https://myaccount.google.com/security)
# 2. Create an App Password at https://myaccount.google.com/apppasswords (select "Mail" / custom name "Ipon")
# 3. Paste your email and the 16-character generated password below:
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Optional sender display name
EMAIL_FROM="Ipon Savings <your-email@gmail.com>"

# Optional Mailgun fallback (if you ever prefer Mailgun)
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""
MAILGUN_FROM="Ipon Savings <noreply@yourdomain.com>"
