# ==========================================
# Ipon Application Environment Variables
# Checklist: #1 Hide API Keys, #2 Check Env Variables, #3 No Keys in Git
# ==========================================

# Application Runtime Environment
NODE_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Configuration
DATABASE_URL="file:./dev.db"

# JWT Secret - generate with: openssl rand -base64 32
JWT_SECRET="replace-with-a-secure-random-32-byte-secret-key-in-production"

# Rate Limiting Settings
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=120

# Cookie Security (set to true in production with HTTPS)
SECURE_COOKIES=false

# Optional: Email Service Provider (e.g. Resend, SendGrid, SMTP)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Ipon Savings <notifications@ipon.app>"
